{
  "$defs": {
    "ReleaseReference": {
      "additionalProperties": false,
      "description": "The accepted release that answered one layer, with publisher provenance.",
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "target_feature": {
          "title": "Target Feature",
          "type": "string"
        },
        "dataset_release_id": {
          "format": "uuid",
          "title": "Dataset Release Id",
          "type": "string"
        },
        "release_version": {
          "title": "Release Version",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "string"
        },
        "accepted_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted At"
        },
        "acquired_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Acquired At"
        },
        "source_updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Updated At"
        },
        "publisher": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Publisher"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Name"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Url"
        },
        "licence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Licence Id"
        },
        "licence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Licence Url"
        },
        "freshness_days": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Freshness Days"
        }
      },
      "required": [
        "dataset_id",
        "target_feature",
        "dataset_release_id",
        "release_version",
        "schema_version",
        "accepted_at",
        "acquired_at",
        "source_updated_at",
        "publisher",
        "source_name",
        "source_url",
        "licence_id",
        "licence_url",
        "freshness_days"
      ],
      "title": "ReleaseReference",
      "type": "object"
    },
    "SuburbSearchAvailability": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "available",
            "dataset_unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "SuburbSearchAvailability",
      "type": "object"
    },
    "SuburbSearchQuery": {
      "additionalProperties": false,
      "properties": {
        "q": {
          "title": "Q",
          "type": "string"
        },
        "normalised": {
          "title": "Normalised",
          "type": "string"
        },
        "postcode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Postcode"
        }
      },
      "required": [
        "q",
        "normalised",
        "postcode"
      ],
      "title": "SuburbSearchQuery",
      "type": "object"
    },
    "SuburbSummary": {
      "additionalProperties": false,
      "properties": {
        "suburb_id": {
          "description": "Publisher cadid",
          "pattern": "^[1-9][0-9]{0,11}$",
          "title": "Suburb Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "postcode": {
          "anyOf": [
            {
              "pattern": "^[0-9]{4}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Postcode"
        },
        "state": {
          "const": "NSW",
          "title": "State",
          "type": "string"
        },
        "geometry_status": {
          "enum": [
            "valid",
            "invalid",
            "not_provided"
          ],
          "title": "Geometry Status",
          "type": "string"
        },
        "centroid": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "ST_Centroid [longitude, latitude]; may fall outside a concave suburb",
          "title": "Centroid"
        },
        "label_point": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "ST_PointOnSurface [longitude, latitude]; always inside the suburb",
          "title": "Label Point"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "[min_longitude, min_latitude, max_longitude, max_latitude]",
          "title": "Bbox"
        }
      },
      "required": [
        "suburb_id",
        "name",
        "postcode",
        "state",
        "geometry_status",
        "centroid",
        "label_point",
        "bbox"
      ],
      "title": "SuburbSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "propertyscope.suburb-search.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "geography": {
      "const": "nsw-gazetted-suburb",
      "title": "Geography",
      "type": "string"
    },
    "query": {
      "$ref": "#/$defs/SuburbSearchQuery"
    },
    "availability": {
      "$ref": "#/$defs/SuburbSearchAvailability"
    },
    "match": {
      "enum": [
        "none",
        "unique",
        "ambiguous"
      ],
      "title": "Match",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SuburbSummary"
      },
      "title": "Items",
      "type": "array"
    },
    "count": {
      "minimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "release": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseReference"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "geography",
    "query",
    "availability",
    "match",
    "items",
    "count",
    "has_more",
    "release"
  ],
  "title": "SuburbSearchV1",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propertyscope.local/contracts/suburb-search.v1.schema.json"
}
