{
  "$defs": {
    "SafeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "SafeError",
      "type": "object"
    }
  },
  "$id": "https://propertyscope.local/contracts/consumer-import-acknowledgement.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "rows_accepted": {
            "type": "null"
          },
          "rows_received": {
            "type": "null"
          },
          "rows_rejected": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "accepted",
              "rejected",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "rows_received",
          "rows_accepted",
          "rows_rejected"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "rejected",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  ],
  "description": "Consumer-owned operation identity and immutable release evidence.",
  "properties": {
    "consumer_operation_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Consumer Operation Id",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Dataset Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/SafeError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "release_id": {
      "format": "uuid",
      "title": "Release Id",
      "type": "string"
    },
    "rows_accepted": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows Accepted"
    },
    "rows_received": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows Received"
    },
    "rows_rejected": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rows Rejected"
    },
    "schema_version": {
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "accepted",
        "rejected",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Target",
      "type": "string"
    }
  },
  "required": [
    "consumer_operation_id",
    "status",
    "release_id",
    "dataset_id",
    "target",
    "schema_version",
    "content_sha256",
    "record_count"
  ],
  "title": "ConsumerImportAcknowledgement",
  "type": "object"
}
