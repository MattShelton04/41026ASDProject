  "$id": "https://propertyscope.local/contracts/consumer-publication-request.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_path": {
      "pattern": "^/api/data-platform/v1/dataset-releases/[0-9a-f-]+/artifact$",
      "title": "Artifact Path",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Dataset Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 200,
      "minLength": 8,
      "title": "Idempotency Key",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReleaseManifestV1"
        },
        {
          "$ref": "#/$defs/ReleaseManifestV2"
        }
      ]
    },
    "record_count": {
      "minimum": 0,
      "title": "Record Count",
      "type": "integer"
    },
    "release_id": {
      "format": "uuid",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "dataset_id",
    "schema_version",
    "content_sha256",
    "record_count",
    "manifest",
    "artifact_path",
    "idempotency_key"
  ],
  "title": "ConsumerPublicationRequest",
  "type": "object"
}
