{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propertyscope.local/contracts/release-manifest.v1.schema.json",
  "title": "PropertyScope release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "dataset_id", "owner_feature", "publisher", "source_release", "content_sha256", "record_count", "geographies", "measures", "redistribution_policy", "known_limitations"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1, "maxLength": 100},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 150},
    "dataset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 100},
    "owner_feature": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 100},
    "publisher": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_release": {"type": "string", "minLength": 1, "maxLength": 100},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 0},
    "geographies": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"type": "string"}},
    "period": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"}, "to": {"type": "string", "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"}}},
    "measures": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}},
    "redistribution_policy": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "known_limitations": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
    "created_date": {"type": "string", "format": "date"}
  }
}
