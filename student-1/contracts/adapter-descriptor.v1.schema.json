{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propertyscope.local/contracts/adapter-descriptor.v1.schema.json",
  "title": "PropertyScope adapter descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "key", "version", "publisher", "supported_refresh_strategies", "supported_modes", "partition_dimensions", "expected_media_types", "allowed_hosts", "required_secrets", "limits"],
  "properties": {
    "schema_version": {"const": "propertyscope.adapter-descriptor.v1"},
    "key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "publisher": {"type": "string", "minLength": 1},
    "supported_refresh_strategies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["full_snapshot", "append_only_partitioned", "partitioned_snapshot", "manual_versioned_import"]}},
    "supported_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["full_refresh", "reprocess_cached"]}},
    "partition_dimensions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "expected_media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "required_secrets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_objects", "max_bytes", "max_rows", "deadline_seconds", "max_parallelism"],
      "properties": {
        "max_objects": {"type": "integer", "minimum": 1},
        "max_bytes": {"type": "integer", "minimum": 1},
        "max_rows": {"type": "integer", "minimum": 1},
        "deadline_seconds": {"type": "integer", "minimum": 1},
        "max_parallelism": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    }
  }
}
