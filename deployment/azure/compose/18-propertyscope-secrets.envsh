#!/bin/sh
# Production-only nginx entrypoint hook for the shared edge (docker-compose.azure.yml).
# The nginx image sources /docker-entrypoint.d/*.envsh before rendering templates, so the AI-mode
# service token is read from its Compose secret file instead of the container environment.
# Without the secret (cloud AI off) the token stays empty and the AI routes are closed at Caddy.

if [ -r /run/secrets/ai_mode_service_token ]; then
    AI_MODE_SERVICE_TOKEN=$(cat /run/secrets/ai_mode_service_token)
    export AI_MODE_SERVICE_TOKEN
fi
