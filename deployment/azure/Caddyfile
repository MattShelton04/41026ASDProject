# Public TLS edge for the Azure deployment (R2-B5, ADR-048).
#
# Caddy is the only container with published ports (80 and 443). It obtains and renews a
# certificate for the Azure DNS label automatically (ACME HTTP-01 / TLS-ALPN-01), permanently
# redirects HTTP to HTTPS, adds HSTS and security headers, requires operator credentials on
# operations and AI routes, optionally requires a site-wide viewer login everywhere else, and
# proxies to the unchanged nginx edge (shared-frontend:8080) on the private Compose network.
#
# Environment (non-secret, from /opt/propertyscope/app/.env):
#   PROPERTYSCOPE_PUBLIC_HOST  e.g. propertyscope-nsw-g20.australiaeast.cloudapp.azure.com
#   PROPERTYSCOPE_ACME_EMAIL   certificate expiry notices
# Files:
#   /run/secrets/edge_basic_auth           "<user> <bcrypt hash>" (operator), rendered from Key Vault
#   /run/secrets/edge_site_auth            the viewer and operator "<user> <bcrypt hash>" lines
#   /etc/caddy/propertyscope-site-auth.caddy  site-auth-on.caddy (default) or site-auth-off.caddy
#   /etc/caddy/propertyscope-ai.caddy      ai-disabled.caddy (default) or ai-enabled.caddy
# Formatting: `caddy fmt` (deployment/azure/validate-iac.sh checks it).
{
	email {$PROPERTYSCOPE_ACME_EMAIL}
	admin off
	servers {
		protocols h1 h2
	}
}

# Deferred automatically because of the "-" removals, so these also override upstream values.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
		-X-Powered-By
	}
}

{$PROPERTYSCOPE_PUBLIC_HOST} {
	encode zstd gzip

	import security_headers

	request_body {
		max_size 10MB
	}

	# Shared AI-mode routes behind the nginx edge (which injects the AI service token).
	@shared_ai path /api/shared-health/ai-mode /api/ai-mode /api/ai-mode/* /api/v1/* /operations/ai-mode /operations/ai-mode/*

	# Routes that start model runs, call MCP tool callbacks, or operate the Feature 1 / Feature 3
	# data pipelines. Ordinary feature pages, reads and the per-feature CRUD stay public.
	# Collections are matched by NAME (/api/<feature>/v1/[.../]<collection>...), so this list must
	# name every feature's Multi-Agent proxy collection: Feature 1 release-reviews, Feature 2
	# market-briefs, Feature 3 comparison-reviews, Feature 4 evidence-reviews. Each one starts paid model runs and records human
	# decisions under the caller's chosen name. A proxy under a NEW collection name is public until
	# it is added here AND to the nginx sensitive limit map; scripts/tests/test_azure_deployment.py
	# finds every proxy in student-*/backend and fails until both cover it. The only exemption is
	# a proxy's read-only <collection>/capabilities probe: every viewer's page calls it on load, so
	# protecting it would prompt each viewer for the operator login.
	@protected {
		path_regexp protected ^/(operations/|api/(ai-mode|v1)/|api/[a-z-]+/v1/((.+/)?(assistant/turns|agent-runs|case-summary-runs|multi-agent|release-reviews|market-briefs|comparison-reviews|evidence-reviews)|tools/)|api/data-platform/v1/(artifact-retention|jobs/[^/]+/(plans|runs)|ingestion-runs/[^/]+/|dataset-releases/[^/]+/(publish|reject|submit-review|retry-delivery))|api/suburb-analytics/v1/data-imports/)
		not path_regexp capabilities ^/api/[a-z-]+/v1/(.+/)?(release-reviews|market-briefs|comparison-reviews|evidence-reviews)/capabilities$
	}

	# The site-wide login (site-auth-on.caddy) covers everything but the liveness route, which
	# uptime checks and the certificate check of validate-endpoint-security.sh read anonymously.
	@site_login not path /healthz

	route {
		# Credentials first: an anonymous caller learns nothing about protected routes, not even
		# whether the AI tier is on. Its own realm makes a browser that holds the viewer login
		# ask again for the operator login.
		basic_auth @protected bcrypt "PropertyScope operations" {
			import /run/secrets/edge_basic_auth
		}

		# The viewer (or operator) login for every other route when PROPERTYSCOPE_SITE_AUTH=on.
		import /etc/caddy/propertyscope-site-auth.caddy

		# Answers the shared AI routes with 503 "ai_disabled" unless PROPERTYSCOPE_CLOUD_AI=true.
		# The public AI health route (/api/shared-health/ai-mode) is not @protected, so anyone
		# can see that the cloud baseline keeps AI off.
		import /etc/caddy/propertyscope-ai.caddy

		reverse_proxy shared-frontend:8080 {
			header_up X-Forwarded-Proto https
			transport http {
				dial_timeout 5s
				response_header_timeout 190s
			}
		}
	}

	# Responses Caddy writes for an error (the 401 login challenges, 413) skip the deferred site
	# headers, so the first answer a browser sees would carry no HSTS. Error responses get the
	# same headers here; the Basic challenge header set by basic_auth is kept.
	handle_errors {
		import security_headers
		respond "{err.status_code} {err.status_text}"
	}

	log {
		output stdout
		format json
	}
}

# Container health check for docker-compose.azure.yml only: bound to the container's loopback, never
# published and not reachable from the Compose network. It proves Caddy is serving; certificate
# state is checked by propertyscope-vm.sh and the public smoke test.
http://127.0.0.1:8079 {
	bind 127.0.0.1
	respond /healthz "ok" 200
	respond 404
}
