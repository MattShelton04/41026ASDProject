# Azure deployment settings for deployment/azure/deploy.sh (and `uv run scripts/dev.py cloud ...`).
# Copy to deployment/azure/.env.azure (Git-ignored). Values already set in the shell win.
# NOTHING HERE IS SECRET: runtime secrets live only in Key Vault (`deploy.sh secrets`), and
# GitHub Actions signs in with OIDC. GitHub Actions sets the same names as repository variables.

# --- Subscription and placement ---
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=australiaeast
AZURE_RESOURCE_GROUP=rg-propertyscope-prod
# deployment/azure/main.bicepparam (production) or deployment/azure/dev.bicepparam (rehearsal)
AZURE_PARAMETERS_FILE=deployment/azure/main.bicepparam
AZURE_NAME_PREFIX=propertyscope
# Public URL: https://<label>.<region>.cloudapp.azure.com (globally unique within the region)
AZURE_DNS_LABEL=propertyscope-nsw-g20

# --- VM ---
AZURE_VM_SIZE=Standard_D4s_v5
# Needs `az feature register --namespace Microsoft.Compute --name EncryptionAtHost` once.
AZURE_ENCRYPTION_AT_HOST=true
# Daily deallocation (HHmm, AUS Eastern time). Empty or off: no schedule; use off where
# Microsoft.DevTestLab/schedules is not offered (newzealandnorth).
AZURE_AUTO_SHUTDOWN_TIME=2330
# Leave empty: deploy.sh generates a throwaway key (SSH is closed and disabled anyway).
AZURE_VM_SSH_PUBLIC_KEY=

# --- Access ---
# Comma-separated IPv4 addresses/CIDRs (no spaces) allowed to reach HTTPS (443). Empty: the internet.
# Port 80 always stays open (Let's Encrypt). See README "Access control".
AZURE_ALLOWED_HTTPS_SOURCES=
# Comma-separated public IPv4 addresses/CIDRs allowed through the Key Vault firewall.
AZURE_OPERATOR_IP_RANGES=
AZURE_KEY_VAULT_DEFAULT_ACTION=Deny
# Object ID of the GitHub OIDC service principal (granted AcrPush).
AZURE_DEPLOYER_PRINCIPAL_ID=
# Comma-separated user/group object IDs granted Key Vault Secrets Officer (run `deploy.sh secrets`).
AZURE_SECRET_OFFICER_IDS=
# One IPv4 address admitted to the vault only while `deploy.sh secrets` runs (optional).
KEY_VAULT_CLIENT_IP=
# Leave empty. `provision` recovers a soft-deleted vault after a teardown; any value here selects a
# new, empty vault name instead (then rerun `deploy.sh secrets`).
AZURE_KEY_VAULT_NAME_SEED=

# --- Cost guard ---
AZURE_DEPLOY_BUDGET=true
AZURE_MONTHLY_BUDGET=100
# Comma-separated budget alert recipients (the budget is skipped while this is empty).
AZURE_BUDGET_EMAILS=

# --- Application ---
# Let's Encrypt certificate expiry notices.
PROPERTYSCOPE_ACME_EMAIL=
# Operator user for the protected operations and AI routes (password: Key Vault edge-basic-auth-password).
PROPERTYSCOPE_EDGE_USER=propertyscope-operator
# Site-wide viewer login on every page except /healthz (password: Key Vault edge-site-password).
# off makes pages and feature APIs public; operator routes keep their own login either way.
PROPERTYSCOPE_SITE_AUTH=on
PROPERTYSCOPE_SITE_USER=propertyscope
# Do not store the viewer password here: export PROPERTYSCOPE_SITE_PASSWORD in the shell for
# `deploy.sh secrets` (to choose it), `smoke` and `validate-endpoint`.
# While 443 is limited, smoke/validate-endpoint admit this machine's public IPv4 temporarily;
# set it to skip the lookup (https://api.ipify.org).
PROPERTYSCOPE_CLIENT_IP=
# Cloud AI tier: false is the required baseline; `deploy.sh ai on` enables the bonus tiers.
PROPERTYSCOPE_CLOUD_AI=false
# Run the fixture-property collection once per VM (candidate release, never published).
PROPERTYSCOPE_SEED_FIXTURE=true
# First-deploy tolerance on the VM: retries while new RBAC role assignments, the managed identity
# and the vault firewall propagate (12 attempts is about 8 minutes), and the `compose up --wait`
# limit in seconds.
PROPERTYSCOPE_AUTH_RETRY_ATTEMPTS=12
PROPERTYSCOPE_STARTUP_WAIT_SECONDS=900
# Defaults to the checked-out commit SHA (with -dirty for an uncommitted tree).
IMAGE_TAG=
