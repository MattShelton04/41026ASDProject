[Unit]
Description=PropertyScope Multi-Agent Server: Planner, Worker, Reviewer (host process)
Documentation=https://github.com/MattShelton04/41026ASDProject/blob/main/deployment/azure/README.md
PartOf=propertyscope-ai.target
After=network-online.target docker.service propertyscope-ai-mode.service propertyscope-mcp.service
# Skipped cleanly until the ai-services/multi-agent-server package is in the deployed commit.
ConditionPathExists=/opt/propertyscope/src/.venv/bin/multi-agent-server

[Service]
Type=simple
User=propertyscope-ai
Group=propertyscope-ai
WorkingDirectory=/opt/propertyscope/src
# Includes MULTI_AGENT_PORT (5013) and MULTI_AGENT_SERVICE_TOKEN alongside the shared settings.
EnvironmentFile=/opt/propertyscope/secrets/host-ai.env
LoadCredential=openai-api-key:/opt/propertyscope/secrets/openai-api-key
Environment=OPENAI_API_KEY_FILE=%d/openai-api-key
# The package CLI (decision D3); containers reach it through host.docker.internal:5013.
ExecStart=/opt/propertyscope/src/.venv/bin/multi-agent-server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
MemoryMax=1G
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/propertyscope/src/.propertyscope-runtime
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=propertyscope-ai.target
