#!/bin/sh

# Nginx's asynchronous DNS resolver does not consult /etc/hosts. Resolve explicit
# host mappings before envsubst; leave service names to Docker DNS so recreated
# AI containers can receive a new address without restarting the shared edge.
propertyscope_resolve_ai_host() {
    awk -v host="$1" '
        {
            sub(/#.*/, "")
            for (i = 2; i <= NF; i++) {
                if ($i == host) {
                    if (index($1, ":")) print "[" $1 "]"
                    else print $1
                    found = 1
                    exit
                }
            }
        }
        END { if (!found) print host }
    ' "$2"
}

AI_MODE_HOST=$(propertyscope_resolve_ai_host "${AI_MODE_HOST:-host.docker.internal}" /etc/hosts)
export AI_MODE_HOST
