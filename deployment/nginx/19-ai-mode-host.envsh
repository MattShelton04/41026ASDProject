#!/bin/sh

# Nginx's asynchronous DNS resolver does not consult /etc/hosts. Resolve the explicit
# host-gateway mapping for the host AI-mode process before envsubst; any other name is
# left to Docker DNS.
propertyscope_resolve_ai_host() {
    awk -v host="$1" '
        {
            sub(/#.*/, "")
            for (i = 2; i <= NF; i++) {
                if ($i == host) {
                    if (index($1, ":")) print "[" $1 "]"
                    else print $1
                    found = 1
                    exit
                }
            }
        }
        END { if (!found) print host }
    ' "$2"
}

AI_MODE_HOST=$(propertyscope_resolve_ai_host "${AI_MODE_HOST:-host.docker.internal}" /etc/hosts)
export AI_MODE_HOST
