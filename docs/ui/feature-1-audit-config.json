          "interactions": ["feature-ingress", "release-detail-link", "activity-detail-link", "mobile-menu"]
        },
        {
          "id": "shared-roadmap",
          "path": "#release-roadmap",
          "source": "shared/frontend/routes/roadmap.js",
          "requiredStates": ["populated", "planned-capabilities", "long-content"],
          "api": [],
          "interactions": ["status-link", "enabled-capability-link", "mobile-menu"]
        }
      ]
    },
