{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "product": "PropertyScope NSW",
  "baseline": {
    "document": "docs/ui/feature-1-baseline.md",
    "evidenceMode": "source-and-deterministic-tests",
    "liveBrowserConfirmed": true,
    "liveBrowserCoverage": "targeted-spike-not-full-matrix",
    "artifactRoot": "C:\\Users\\mattt\\.codex\\visualizations\\2026\\08\\23\\01a02c87-485e-7bc2-8f31-405261cd9cf7\\ui-baseline",
    "destructiveActionsDefault": "confirmation-only"
  },
  "origins": {
    "shared": "http://localhost:5100/",
    "feature1Direct": "http://localhost:5200/",
    "feature1Edge": "http://localhost:5100/features/data-platform/",
    "aiActivityEdge": "http://localhost:5100/operations/ai-mode/"
  },
  "viewports": [
    {
      "id": "laptop-wide",
      "width": 1440,
      "height": 1000,
      "gate": "release-critical-full-matrix"
    },
    {
      "id": "laptop-compact",
      "width": 1024,
      "height": 768,
      "gate": "release-critical-full-matrix"
    },
    {
      "id": "tablet-portrait",
      "width": 768,
      "height": 1024,
      "gate": "required-capture-bounded-resilience"
    },
    {
      "id": "mobile",
      "width": 390,
      "height": 844,
      "gate": "required-capture-bounded-resilience"
    }
  ],
  "viewportPolicy": {
    "releaseCritical": [
      "laptop-wide",
      "laptop-compact"
    ],
    "boundedResilience": [
      "tablet-portrait",
      "mobile"
    ],
    "boundedResilienceFailures": [
      "page-horizontal-overflow",
      "clipped-primary-action",
      "broken-navigation",
      "broken-property-search",
      "unusable-dialog-or-confirmation",
      "blocked-core-task",
      "keyboard-trap"
    ],
    "advisoryAtNarrowWidths": [
      "dense-operator-table-card-alternative",
      "full-operator-feature-parity",
      "non-critical-column-prioritisation"
    ]
  },
  "stateCatalog": {
    "loading": "A request is pending and context remains identifiable.",
    "empty": "A valid zero-result response has a truthful next action.",
    "populated": "Representative deterministic records render.",
    "validation": "Client or API validation keeps input and explains recovery.",
    "permission": "A forbidden/read-only response preserves context without exposing mutation.",
    "partial": "Independent successful sections remain when one dependency fails.",
    "error": "A classified failure includes retry or safe next action and request ID where supplied.",
    "long-content": "Long and hostile text cannot inject markup, overflow the page, or hide actions.",
    "slow": "Delayed responses do not cause stale replacement, duplicate action, or unexplained layout shift."
  },
  "globalAssertions": [
    "no-unexpected-page-exception",
    "no-unexpected-console-error",
    "no-page-horizontal-overflow",
    "no-clipped-primary-action",
    "one-main-landmark",
    "keyboard-visible-focus",
    "route-heading-and-title",
    "request-failures-classified",
    "mobile-navigation-usable",
    "destructive-controls-open-confirmation-without-mutation"
  ],
  "routeGroups": [
    {
      "id": "shared-shell",
      "workspace": "shared",
      "baseOrigin": "shared",
      "routes": [
        {
          "id": "shared-home",
          "path": "#home",
          "aliases": ["", "#top", "#research-areas", "#operations"],
          "source": "shared/frontend/index.html; shared/frontend/app.js",
          "requiredStates": ["populated", "planned-capabilities", "long-content"],
          "api": [],
          "interactions": ["header-search", "hero-search", "hash-navigation", "feature-ingress", "activity-ingress", "mobile-menu"]
        },
        {
          "id": "shared-features",
          "path": "#features",
          "source": "shared/frontend/routes/features.js",
          "requiredStates": ["populated", "planned-capabilities", "long-content"],
          "api": [],
          "interactions": ["availability-link", "roadmap-link", "mobile-menu"]
        },
        {
          "id": "shared-status",
          "path": "#system-status",
          "source": "shared/frontend/routes/status.js",
          "requiredStates": ["loading", "populated", "partial", "error", "slow", "long-content"],
          "api": ["GET /healthz", "GET /api/shared-health/data-platform", "GET /api/shared-health/ai-mode"],
          "interactions": ["refresh-status", "service-link", "mobile-menu"]
        },
        {
          "id": "shared-evidence",
