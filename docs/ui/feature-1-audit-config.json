          "requiredStates": ["loading", "populated", "partial", "unknown-coverage", "invalid-coordinate", "map-fallback", "error", "slow", "long-content"],
          "api": [
            "GET /api/data-platform/v1/properties/{property_ref}",
            "GET /api/data-platform/v1/properties/{property_ref}/map-context",
            "GET /api/data-platform/v1/properties/{property_ref}/coverage",
            "GET /api/data-platform/v1/properties/{property_ref}/report-section"
