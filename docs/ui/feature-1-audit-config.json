          "source": "student-1/frontend/routes/properties.js",
          "requiredStates": ["landing", "loading", "populated", "empty", "unsupported", "error", "slow", "long-content"],
          "api": ["GET /api/data-platform/v1/properties/search?q={query}&state=NSW&limit=25"],
          "interactions": ["submit-search", "open-match", "toggle-all-match-details", "retry", "mobile-menu"]
        },
        {
          "id": "property-detail",
          "path": "#properties/{property_ref}",
          "query": ["q"],
