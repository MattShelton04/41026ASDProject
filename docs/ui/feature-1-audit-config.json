          "api": ["GET/PUT /api/data-platform/v1/jobs/{id}", "GET jobs/{id}/capabilities", "GET runtime-capabilities", "POST jobs/{id}/plans", "POST jobs/{id}/runs"],
          "interactions": ["edit-job", "open-history", "select-run-mode", "select-source-profile", "edit-bounded-scope", "toggle-advanced-json", "preview-plan", "start-update-confirmation", "backfill-confirmation", "mobile-menu"]
