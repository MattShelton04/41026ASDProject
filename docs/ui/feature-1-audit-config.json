          "api": ["GET ingestion-runs/{id}", "GET ingestion-runs/{id}/tasks", "GET ingestion-runs/{id}/quality-results", "GET ingestion-runs/{id}/artifacts", "GET dataset-releases", "POST ingestion-runs/{id}/{resume|retry|reprocess-cached|cancel}"],
          "interactions": ["resume-confirmation", "retry-confirmation", "reprocess-confirmation", "cancel-confirmation", "open-ai-review", "open-parent-run", "open-quality", "open-artifacts", "toggle-technical-details", "poll-status", "mobile-menu"]
