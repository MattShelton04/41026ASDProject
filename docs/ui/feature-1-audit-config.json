          "api": ["GET/PUT/DELETE dataset-releases/{id}", "GET dataset-releases/{id}/manifest", "GET dataset-releases/{id}/records", "GET ingestion-runs/{id}/quality-results", "POST dataset-releases/{id}/{submit-review|publish|reject}", "POST dataset-releases/{id}/agent-runs"],
          "interactions": ["edit-release", "delete-confirmation", "submit-review-confirmation", "publish-confirmation", "reject-confirmation", "open-ai-review", "toggle-manifest", "toggle-coverage", "toggle-quality-sample", "preview-previous", "preview-next", "mobile-menu"]
        }
