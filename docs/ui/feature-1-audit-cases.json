      "readiness": "#main-content h1",
      "cases": [
        {"id": "canonical", "scenario": "populated", "states": ["populated", "planned-capabilities"], "quick": true},
        {"id": "long-input", "scenario": "populated", "states": ["long-content"], "setup": [
          {"action": "fill", "selector": "#property-search", "value": "An unusually long deterministic NSW address value that remains visible without changing production data contracts"},
          {"action": "fill", "selector": "#header-search", "value": "An unusually long deterministic NSW address value that remains visible without changing production data contracts"}
        ]}
      ],
      "deferredStates": {}
    },
    "shared-features": {
      "readiness": "#main-content h1",
      "cases": [{"id": "canonical", "scenario": "populated", "states": ["populated", "planned-capabilities"]}],
      "deferredStates": {"long-content": "Trusted static copy has no fixture-backed dynamic field to vary."}
    },
    "shared-status": {
      "readiness": "#main-content h1",
