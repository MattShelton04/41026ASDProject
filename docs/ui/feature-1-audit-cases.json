{
  "templates": {
    "populated": {"scenario": "populated", "states": ["populated"]},
    "empty": {"scenario": "empty", "states": ["empty"]},
    "error": {"scenario": "error", "states": ["error"]},
    "partial": {"scenario": "partial", "states": ["partial"]},
    "long-content": {"scenario": "long-content", "states": ["long-content"]},
    "loading": {"scenario": "slow", "states": ["loading"], "capturePhase": "loading", "settleMs": 50, "readiness": ".loading-state"},
