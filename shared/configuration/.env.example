# Release 0 local profile based on the course AI configuration guide.
# AI-mode uses the native Ollama API. A course-guide /v1 suffix is accepted and normalized.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_REVIEW_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_KEEP_ALIVE=5m
AI_MODE_MAX_MODEL_RESPONSE_BYTES=1048576
# Leave false for graceful host development; the integrated Compose profile sets true.
AI_MODE_REQUIRE_OLLAMA_READY=false
AI_MODE_DATABASE_PATH=instance/agent-state.sqlite3

# Compose host ports and the route used when AI-mode is containerised but Ollama is native.
AI_MODE_PORT=5005
OLLAMA_PORT=11434
AI_MODE_OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODE_MEMORY_LIMIT=512m
AI_MODE_CPU_LIMIT=1.0
OLLAMA_MEMORY_LIMIT=4g
OLLAMA_CPU_LIMIT=4.0
# Used only with docker-compose.gpu.yml; zero is the first visible NVIDIA GPU.
OLLAMA_GPU_DEVICE_ID=0

# Define this after the shared database service name and port are agreed.
DATABASE_SERVICE_URL=

# Required in later releases if the selected design uses the recommended model.
OLLAMA_REASONING_MODEL=deepseek-r1:8b

# Release-gated local service flags. Cloud deployment must keep all three false.
MCP_ENABLED=false
RAG_ENABLED=false
MULTI_AGENT_ENABLED=false
