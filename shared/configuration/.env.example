# Release 0 remote LLM provider. Never place a real key in this tracked template.
AI_MODE_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Alternative used inside Compose; do not set both variables for one AI-mode process.
OPENAI_API_KEY_FILE=
OPENAI_BASE_URL=https://api.openai.com/v1
# Gemini development alternative. Use AI_MODE_LLM_PROVIDER=gemini, set GEMINI_API_KEY,
# and select gemini-development.v1 or the more capable gemini-quality.v1 profile.
GEMINI_API_KEY=
GEMINI_API_KEY_FILE=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Keep false outside trusted local development. Set true for an HTTP endpoint such as
# http://host.docker.internal:8080/v1.
OPENAI_ALLOW_INSECURE_HTTP=false
# AI-mode resolves logical profiles through its validated registry.
AI_MODE_DEFAULT_MODEL_PROFILE=remote-standard.v1
# Optional path to a complete replacement registry; the bundled registry is the default.
AI_MODE_MODEL_REGISTRY_PATH=
OPENAI_TIMEOUT_SECONDS=120
# Keep readiness bounded independently from potentially long generation calls.
OPENAI_HEALTH_TIMEOUT_SECONDS=2
# Avoid turning container health polling into repeated provider API traffic.
OPENAI_HEALTH_CACHE_SECONDS=60
OPENAI_MAX_RETRIES=2
# Disable if a compatible endpoint implements Responses but not OpenAI cache extensions.
OPENAI_PROMPT_CACHE_ENABLED=true
AI_MODE_MAX_MODEL_RESPONSE_BYTES=1048576
AI_MODE_MAX_REQUEST_BYTES=65536
AI_MODE_MAX_TOOL_REQUEST_BYTES=262144
AI_MODE_MAX_TOOL_RESPONSE_BYTES=1048576
# Durable discovery prevents lost work; these tune only the local wake-up worker.
AI_MODE_QUEUE_CAPACITY=100
AI_MODE_QUEUE_RECONCILE_INTERVAL_SECONDS=1
# One-line JSON operational logs. Keep environment labels lowercase identifiers.
AI_MODE_ENVIRONMENT=local
AI_MODE_LOG_LEVEL=INFO
AI_MODE_OPERATIONS_ENABLED=false
# Leave false for graceful host development; the integrated Compose profile sets true.
AI_MODE_REQUIRE_PROVIDER_READY=false
AI_MODE_DATABASE_PATH=instance/agent-state.sqlite3
# Set only after approved feature services have fixed internal identities and routes.
AI_MODE_TOOL_CATALOG_PATH=
AI_MODE_TOOL_CATALOG_PATHS=
# Development-only secret. When unset, the evidence route does not exist.
AI_MODE_EVIDENCE_ACCESS_TOKEN=

# Compose host ports and AI-mode resource bounds.
AI_MODE_PORT=5005
AI_MODE_MEMORY_LIMIT=512m
AI_MODE_CPU_LIMIT=1.0

# Define this after the shared database service name and port are agreed.
DATABASE_SERVICE_URL=

# Release-gated local service flags. Cloud deployment must keep all three false.
MCP_ENABLED=false
RAG_ENABLED=false
MULTI_AGENT_ENABLED=false
