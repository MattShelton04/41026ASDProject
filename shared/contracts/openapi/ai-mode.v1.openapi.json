{
  "components": {
    "parameters": {
      "RequestId": {
        "in": "header",
        "name": "X-Request-ID",
        "required": false,
        "schema": {
          "maxLength": 200,
          "type": "string"
        }
      }
    },
    "schemas": {
      "AgentRun": {
        "additionalProperties": false,
        "description": "Public, safe snapshot of a persisted agent run.",
        "properties": {
          "cancel_requested": {
            "default": false,
            "title": "Cancel Requested",
            "type": "boolean"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "feature_key": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Feature Key",
            "type": "string"
          },
          "final_result": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Final Result"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "iteration_count": {
            "default": 0,
            "minimum": 0,
            "title": "Iteration Count",
            "type": "integer"
          },
          "limits": {
            "$ref": "#/components/schemas/RunLimits"
          },
          "model_profile": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Model Profile",
            "type": "string"
          },
          "objective": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Objective",
            "type": "string"
          },
          "prompt_set": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Prompt Set",
            "type": "string"
          },
          "request_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "tool_call_count": {
            "default": 0,
            "minimum": 0,
            "title": "Tool Call Count",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "default": 0,
            "minimum": 0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "request_id",
          "feature_key",
          "objective",
          "status",
          "prompt_set",
          "model_profile",
          "limits",
          "created_at",
          "updated_at"
        ],
        "title": "AgentRun",
        "type": "object"
      },
      "AgentRunDetail": {
        "additionalProperties": false,
        "description": "Run snapshot plus its ordered, safe phase history.",
        "properties": {
          "reviews": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/HumanReview"
            },
            "title": "Reviews",
            "type": "array"
          },
          "run": {
            "$ref": "#/components/schemas/AgentRun"
          },
          "steps": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/AgentStep"
            },
            "title": "Steps",
            "type": "array"
          }
        },
        "required": [
          "run"
        ],
        "title": "AgentRunDetail",
        "type": "object"
      },
      "AgentRunRequest": {
        "additionalProperties": false,
        "description": "Request accepted from a feature backend to start one agent run.",
        "properties": {
          "feature_key": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Feature Key",
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/RunLimits"
          },
          "model_profile": {
            "default": "local-small.v1",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Model Profile",
            "type": "string"
          },
          "objective": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Objective",
            "type": "string"
          },
          "prompt_set": {
            "const": "default.v1",
            "default": "default.v1",
            "title": "Prompt Set",
            "type": "string"
          }
        },
        "required": [
          "feature_key",
          "objective"
        ],
        "title": "AgentRunRequest",
        "type": "object"
      },
      "AgentStep": {
        "additionalProperties": false,
        "description": "Safe persisted summary of one run phase.",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Completed At"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ToolError"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "input": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "maxProperties": 100,
            "title": "Input",
            "type": "object"
          },
          "output": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "maxProperties": 100,
            "title": "Output",
            "type": "object"
          },
          "phase": {
            "$ref": "#/components/schemas/StepPhase"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "sequence": {
            "minimum": 1,
            "title": "Sequence",
            "type": "integer"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/StepStatus"
          }
        },
        "required": [
          "id",
          "run_id",
          "sequence",
          "phase",
          "status"
        ],
        "title": "AgentStep",
        "type": "object"
      },
      "ApprovalStatus": {
        "description": "Human approval state for a protected tool call.",
        "enum": [
          "not_required",
          "pending",
          "approved",
          "rejected"
        ],
        "title": "ApprovalStatus",
        "type": "string"
      },
      "FieldIssue": {
        "additionalProperties": false,
        "description": "Validation issue associated with a request field.",
        "properties": {
          "code": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "field": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Field",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "code"
        ],
        "title": "FieldIssue",
        "type": "object"
      },
      "HealthCheck": {
        "additionalProperties": false,
        "description": "State of one readiness dependency or internal component.",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthCheck",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Standard service health payload.",
        "properties": {
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheck"
            },
            "title": "Checks",
            "type": "object"
          },
          "service": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Service",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "version": {
            "maxLength": 50,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "HealthStatus": {
        "description": "Portable health state used by liveness and readiness endpoints.",
        "enum": [
          "healthy",
          "degraded",
          "unhealthy"
        ],
        "title": "HealthStatus",
        "type": "string"
      },
      "HumanReview": {
        "additionalProperties": false,
        "description": "Immutable audit record for a protected-action decision.",
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Comment"
          },
          "decision": {
            "$ref": "#/components/schemas/ReviewDecision"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reviewed_at": {
            "format": "date-time",
            "title": "Reviewed At",
            "type": "string"
          },
          "reviewer": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Reviewer",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "step_id": {
            "format": "uuid",
            "title": "Step Id",
            "type": "string"
          },
          "tool_call": {
            "$ref": "#/components/schemas/ToolCall"
          }
        },
        "required": [
          "id",
          "run_id",
          "step_id",
          "tool_call",
          "decision",
          "reviewer",
          "reviewed_at"
        ],
        "title": "HumanReview",
        "type": "object"
      },
      "HumanReviewRequest": {
        "additionalProperties": false,
        "description": "Authenticated human decision submitted for a pending action.",
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Comment"
          },
          "decision": {
            "$ref": "#/components/schemas/ReviewDecision"
          },
          "reviewer": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Reviewer",
            "type": "string"
          }
        },
        "required": [
          "decision",
          "reviewer"
        ],
        "title": "HumanReviewRequest",
        "type": "object"
      },
      "JsonValue": {},
      "ProblemDetail": {
        "additionalProperties": false,
        "description": "Problem Details-compatible error response with stable project extensions.",
        "properties": {
          "code": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "default": [],
            "items": {
              "$ref": "#/components/schemas/FieldIssue"
            },
            "title": "Errors",
            "type": "array"
          },
          "instance": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "request_id": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Request Id"
          },
          "status": {
            "maximum": 599,
            "minimum": 400,
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetail",
        "type": "object"
      },
      "ReviewDecision": {
        "description": "Human decision for exactly one pending protected action.",
        "enum": [
          "approve",
          "reject"
        ],
        "title": "ReviewDecision",
        "type": "string"
      },
      "RunLimits": {
        "additionalProperties": false,
        "description": "Hard execution limits controlled by deterministic code.",
        "properties": {
          "max_iterations": {
            "default": 6,
            "maximum": 20,
            "minimum": 1,
            "title": "Max Iterations",
            "type": "integer"
          },
          "max_model_repairs": {
            "default": 1,
            "maximum": 1,
            "minimum": 0,
            "title": "Max Model Repairs",
            "type": "integer"
          },
          "max_tool_calls": {
            "default": 12,
            "maximum": 50,
            "minimum": 1,
            "title": "Max Tool Calls",
            "type": "integer"
          },
          "time_budget_ms": {
            "default": 120000,
            "maximum": 900000,
            "minimum": 1000,
            "title": "Time Budget Ms",
            "type": "integer"
          }
        },
        "title": "RunLimits",
        "type": "object"
      },
      "RunStatus": {
        "description": "Persisted lifecycle of an agent run.",
        "enum": [
          "queued",
          "planning",
          "ready",
          "acting",
          "observing",
          "adapting",
          "review_required",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "RunStatus",
        "type": "string"
      },
      "SideEffectClass": {
        "description": "Policy classification for model-callable tools.",
        "enum": [
          "read_only",
          "reversible_write",
          "destructive_write",
          "external_effect"
        ],
        "title": "SideEffectClass",
        "type": "string"
      },
      "StepPhase": {
        "description": "Four auditable phases of the shared agentic loop.",
        "enum": [
          "plan",
          "act",
          "observe",
          "adapt"
        ],
        "title": "StepPhase",
        "type": "string"
      },
      "StepStatus": {
        "description": "Execution status of one persisted phase step.",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ],
        "title": "StepStatus",
        "type": "string"
      },
      "ToolCall": {
        "additionalProperties": false,
        "description": "Validated request to execute one tool.",
        "properties": {
          "approval_status": {
            "$ref": "#/components/schemas/ApprovalStatus"
          },
          "arguments": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "maxProperties": 100,
            "title": "Arguments",
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Idempotency Key"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "step_id": {
            "format": "uuid",
            "title": "Step Id",
            "type": "string"
          },
          "tool_name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Tool Name",
            "type": "string"
          },
          "tool_version": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Tool Version",
            "type": "string"
          }
        },
        "required": [
          "id",
          "run_id",
          "step_id",
          "tool_name",
          "tool_version",
          "approval_status"
        ],
        "title": "ToolCall",
        "type": "object"
      },
      "ToolDefinition": {
        "additionalProperties": false,
        "description": "Allowlisted tool metadata and its JSON Schema boundary.",
        "properties": {
          "description": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Description",
            "type": "string"
          },
          "input_schema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Input Schema",
            "type": "object"
          },
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Name",
            "type": "string"
          },
          "output_schema": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Output Schema",
            "type": "object"
          },
          "requires_approval": {
            "default": false,
            "title": "Requires Approval",
            "type": "boolean"
          },
          "side_effect": {
            "$ref": "#/components/schemas/SideEffectClass"
          },
          "timeout_ms": {
            "default": 10000,
            "maximum": 120000,
            "minimum": 100,
            "title": "Timeout Ms",
            "type": "integer"
          },
          "version": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "description",
          "input_schema",
          "output_schema",
          "side_effect"
        ],
        "title": "ToolDefinition",
        "type": "object"
      },
      "ToolError": {
        "additionalProperties": false,
        "description": "Safe error returned to orchestration code instead of an exception trace.",
        "properties": {
          "code": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ToolError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Release 0 shared bounded agent-run orchestration API.",
    "title": "ASD AI-mode API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/agent-runs": {
      "post": {
        "operationId": "createAgentRun",
        "parameters": [
          {
            "$ref": "#/components/parameters/RequestId"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            },
            "description": "Run persisted and accepted",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              },
              "X-Agent-Run-ID": {
                "schema": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Problem Details-compatible error"
          },
          "415": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Problem Details-compatible error"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Problem Details-compatible error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Problem Details-compatible error"
          }
        }
      }
    },
    "/api/v1/agent-runs/{run_id}": {
      "get": {
        "operationId": "getAgentRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRunDetail"
                }
              }
            },
            "description": "Current run and safe ordered history"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Problem Details-compatible error"
          }
        }
      }
    },
    "/api/v1/agent-runs/{run_id}/cancel": {
      "post": {
        "operationId": "cancelAgentRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentRun"
                }
              }
            },
            "description": "Cancellation intent recorded"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description": "Problem Details-compatible error"
          }
        }
      }
    },
    "/api/v1/agent-runs/{run_id}/reviews": {
      "post": {
        "operationId": "reviewAgentRun",
        "parameters": [
          {
            "in": "path",
            "name": "run_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
