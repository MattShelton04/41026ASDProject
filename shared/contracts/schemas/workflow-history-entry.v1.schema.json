{
  "$defs": {
    "AgentRole": {
      "description": "Who acted: one of the three agents, the human reviewer, or the server itself.",
      "enum": [
        "planner",
        "worker",
        "reviewer",
        "human",
        "system"
      ],
      "title": "AgentRole",
      "type": "string"
    },
    "WorkflowState": {
      "description": "Persisted lifecycle of one Planner → Worker → Reviewer → Human workflow run.",
      "enum": [
        "planning",
        "working",
        "reviewing",
        "awaiting_human",
        "approved",
        "corrected",
        "partially_accepted",
        "rejected",
        "failed",
        "cancelled"
      ],
      "title": "WorkflowState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One state transition, as appended to ``workflow_history.jsonl``.",
  "properties": {
    "actor": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Actor",
      "type": "string"
    },
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "from_state": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkflowState"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
      "title": "Request Id",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/AgentRole"
    },
    "round": {
      "maximum": 2,
      "minimum": 1,
      "title": "Round",
      "type": "integer"
    },
    "run_id": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "to_state": {
      "$ref": "#/$defs/WorkflowState"
    }
  },
  "required": [
    "sequence",
    "run_id",
    "request_id",
    "at",
    "from_state",
    "to_state",
    "round",
    "actor",
    "role",
    "reason"
  ],
  "title": "WorkflowHistoryEntry",
  "type": "object"
}
