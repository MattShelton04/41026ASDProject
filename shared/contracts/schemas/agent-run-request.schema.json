{
  "$defs": {
    "GroundingRequest": {
      "additionalProperties": false,
      "description": "Public guidance scope fixed by the caller, never by retrieved instructions.",
      "properties": {
        "corpus_id": {
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Corpus Id",
          "type": "string"
        }
      },
      "required": [
        "corpus_id"
      ],
      "title": "GroundingRequest",
      "type": "object"
    },
    "RunLimits": {
      "additionalProperties": false,
      "description": "Hard execution limits controlled by deterministic code.",
      "properties": {
        "max_iterations": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_model_repairs": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Model Repairs",
          "type": "integer"
        },
        "max_parallel_tools": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Max Parallel Tools",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "time_budget_ms": {
          "default": 180000,
          "maximum": 900000,
          "minimum": 1000,
          "title": "Time Budget Ms",
          "type": "integer"
        }
      },
      "title": "RunLimits",
      "type": "object"
    },
    "TrustedIdentifier": {
      "additionalProperties": false,
      "description": "One feature-supplied identifier that orchestration may copy into a tool call.",
      "properties": {
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "format": "uuid",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "TrustedIdentifier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Request accepted from a feature backend to start one agent run.",
  "properties": {
    "feature_key": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Feature Key",
      "type": "string"
    },
    "grounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/GroundingRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "limits": {
      "$ref": "#/$defs/RunLimits"
    },
    "model_profile": {
      "default": "remote-standard.v1",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Model Profile",
      "type": "string"
    },
    "objective": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "prompt_set": {
      "default": "default.v7",
      "enum": [
        "default.v1",
        "default.v2",
        "default.v3",
        "default.v4",
        "default.v5",
        "default.v6",
        "default.v7",
        "default.v8",
        "default.v9",
        "review-multi-agent.v1",
        "review-testing.v1",
        "review-cloud.v1"
      ],
      "title": "Prompt Set",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "description": "Short display label for activity history, such as the user's question. Shown to operators only; never sent to the model as instructions.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "tool_allowlist": {
      "anyOf": [
        {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Allowlist"
    },
    "trusted_identifiers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TrustedIdentifier"
      },
      "maxItems": 100,
      "title": "Trusted Identifiers",
      "type": "array"
    }
  },
  "required": [
    "feature_key",
    "objective"
  ],
  "title": "AgentRunRequest",
  "type": "object"
}
