{
  "$defs": {
    "RunLimits": {
      "additionalProperties": false,
      "description": "Hard execution limits controlled by deterministic code.",
      "properties": {
        "max_iterations": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_model_repairs": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Model Repairs",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 12,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "time_budget_ms": {
          "default": 120000,
          "maximum": 900000,
          "minimum": 1000,
          "title": "Time Budget Ms",
          "type": "integer"
        }
      },
      "title": "RunLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Request accepted from a feature backend to start one agent run.",
  "properties": {
    "feature_key": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Feature Key",
      "type": "string"
    },
    "limits": {
      "$ref": "#/$defs/RunLimits"
    },
    "model_profile": {
      "default": "local-standard.v1",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Model Profile",
      "type": "string"
    },
    "objective": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "prompt_set": {
      "default": "default.v2",
      "enum": [
        "default.v1",
        "default.v2"
      ],
      "title": "Prompt Set",
      "type": "string"
    }
  },
  "required": [
    "feature_key",
    "objective"
  ],
  "title": "AgentRunRequest",
  "type": "object"
}
