{
  "$defs": {
    "GroundingRequest": {
      "additionalProperties": false,
      "description": "Public guidance scope fixed by the caller, never by retrieved instructions.",
      "properties": {
        "corpus_id": {
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Corpus Id",
          "type": "string"
        }
      },
      "required": [
        "corpus_id"
      ],
      "title": "GroundingRequest",
      "type": "object"
    },
    "JsonValue": {},
    "RunLimits": {
      "additionalProperties": false,
      "description": "Hard execution limits controlled by deterministic code.",
      "properties": {
        "max_iterations": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_model_repairs": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Model Repairs",
          "type": "integer"
        },
        "max_parallel_tools": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Max Parallel Tools",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "time_budget_ms": {
          "default": 180000,
          "maximum": 900000,
          "minimum": 1000,
          "title": "Time Budget Ms",
          "type": "integer"
        }
      },
      "title": "RunLimits",
      "type": "object"
    },
    "RunStatus": {
      "description": "Persisted lifecycle of an agent run.",
      "enum": [
        "queued",
        "planning",
        "ready",
        "acting",
        "observing",
        "adapting",
        "review_required",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "ToolError": {
      "additionalProperties": false,
      "description": "Safe error returned to orchestration code instead of an exception trace.",
      "properties": {
        "code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    },
    "TrustedIdentifier": {
      "additionalProperties": false,
      "description": "One feature-supplied identifier that orchestration may copy into a tool call.",
      "properties": {
        "kind": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "format": "uuid",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "TrustedIdentifier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Public, safe snapshot of a persisted agent run.",
  "properties": {
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "feature_key": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Feature Key",
      "type": "string"
    },
    "final_result": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Final Result"
    },
    "grounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/GroundingRequest"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "iteration_count": {
      "default": 0,
      "minimum": 0,
      "title": "Iteration Count",
      "type": "integer"
    },
    "limits": {
      "$ref": "#/$defs/RunLimits"
    },
    "model_profile": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Model Profile",
      "type": "string"
    },
    "objective": {
      "maxLength": 16000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "prompt_set": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Prompt Set",
      "type": "string"
    },
    "request_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
      "title": "Request Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "title": {
      "anyOf": [
        {
          "description": "Short display label for activity history, such as the user's question. Shown to operators only; never sent to the model as instructions.",
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "tool_allowlist": {
      "anyOf": [
        {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 50,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Allowlist"
    },
    "tool_call_count": {
      "default": 0,
      "minimum": 0,
      "title": "Tool Call Count",
      "type": "integer"
    },
    "traceparent": {
      "anyOf": [
        {
          "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceparent"
    },
    "trusted_identifiers": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TrustedIdentifier"
      },
      "maxItems": 100,
      "title": "Trusted Identifiers",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 0,
      "minimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "request_id",
    "feature_key",
    "objective",
    "status",
    "prompt_set",
    "model_profile",
    "limits",
    "created_at",
    "updated_at"
  ],
  "title": "AgentRun",
  "type": "object"
}
