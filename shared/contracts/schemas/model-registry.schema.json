{
  "$defs": {
    "ModelProfile": {
      "additionalProperties": false,
      "description": "Stable logical name with role-routed models and bounded operational settings.",
      "properties": {
        "context_tokens": {
          "maximum": 2000000,
          "minimum": 1024,
          "title": "Context Tokens",
          "type": "integer"
        },
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "key": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "maximum_output_tokens": {
          "maximum": 32768,
          "minimum": 1,
          "title": "Maximum Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "$ref": "#/$defs/ModelReasoningEffort"
        },
        "role_models": {
          "additionalProperties": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxProperties": 3,
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/ModelRoleName"
          },
          "title": "Role Models",
          "type": "object"
        }
      },
      "required": [
        "key",
        "role_models",
        "context_tokens",
        "maximum_output_tokens",
        "reasoning_effort",
        "description"
      ],
      "title": "ModelProfile",
      "type": "object"
    },
    "ModelProviderName": {
      "description": "Remote model providers supported by the current AI-mode composition.",
      "enum": [
        "gemini",
        "openai"
      ],
      "title": "ModelProviderName",
      "type": "string"
    },
    "ModelReasoningEffort": {
      "description": "Portable configured reasoning effort for reasoning-capable models.",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "ModelReasoningEffort",
      "type": "string"
    },
    "ModelRoleName": {
      "description": "Agent roles for which a runtime profile is intended.",
      "enum": [
        "planner",
        "adapter",
        "reviewer"
      ],
      "title": "ModelRoleName",
      "type": "string"
    },
    "SupportedModel": {
      "additionalProperties": false,
      "description": "One concrete API model with traceable capacity metadata.",
      "properties": {
        "description": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "key": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Key",
          "type": "string"
        },
        "maximum_context_tokens": {
          "maximum": 2000000,
          "minimum": 1024,
          "title": "Maximum Context Tokens",
          "type": "integer"
        },
        "maximum_output_tokens": {
          "maximum": 1000000,
          "minimum": 1,
          "title": "Maximum Output Tokens",
          "type": "integer"
        },
        "model_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
          "title": "Model Id",
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ModelProviderName"
        },
        "source_url": {
          "pattern": "^https://",
          "title": "Source Url",
          "type": "string"
        }
      },
      "required": [
        "key",
        "provider",
        "model_id",
        "maximum_context_tokens",
        "maximum_output_tokens",
        "source_url",
        "description"
      ],
      "title": "SupportedModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned catalogue returned by AI-mode and loaded at composition time.",
  "properties": {
    "default_profile": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Default Profile",
      "type": "string"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/SupportedModel"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ModelProfile"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "default_profile",
    "models",
    "profiles"
  ],
  "title": "ModelRegistry",
  "type": "object"
}
