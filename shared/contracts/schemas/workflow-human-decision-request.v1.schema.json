{
  "$defs": {
    "HumanDecisionKind": {
      "description": "The four outcomes a human reviewer may record.",
      "enum": [
        "approve",
        "correct",
        "partial",
        "reject"
      ],
      "title": "HumanDecisionKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Body of ``POST /runs/{run_id}/decision``.",
  "properties": {
    "accepted_step_ids": {
      "default": [],
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_-]*$",
        "type": "string"
      },
      "maxItems": 10,
      "title": "Accepted Step Ids",
      "type": "array"
    },
    "actor": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Actor",
      "type": "string"
    },
    "decision": {
      "$ref": "#/$defs/HumanDecisionKind"
    },
    "note": {
      "default": "",
      "maxLength": 2000,
      "title": "Note",
      "type": "string"
    }
  },
  "required": [
    "decision",
    "actor"
  ],
  "title": "HumanDecisionRequest",
  "type": "object"
}
