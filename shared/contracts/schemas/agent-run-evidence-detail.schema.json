{
  "$defs": {
    "AdaptationDecision": {
      "description": "Validated decision made after observing an action.",
      "enum": [
        "continue",
        "replan",
        "request_review",
        "complete",
        "fail"
      ],
      "title": "AdaptationDecision",
      "type": "string"
    },
    "AdaptationEvidence": {
      "additionalProperties": false,
      "description": "Safe post-observation decision and optional projected result.",
      "properties": {
        "decision": {
          "$ref": "#/$defs/AdaptationDecision"
        },
        "justification": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "redacted_final_result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Final Result"
        }
      },
      "required": [
        "decision",
        "justification"
      ],
      "title": "AdaptationEvidence",
      "type": "object"
    },
    "AgentRunSummary": {
      "additionalProperties": false,
      "description": "Compact, safe row returned by the operations run index.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "feature_key": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Feature Key",
          "type": "string"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "iteration_count": {
          "minimum": 0,
          "title": "Iteration Count",
          "type": "integer"
        },
        "latest_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepPhase"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "latest_step_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model_profile": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Model Profile",
          "type": "string"
        },
        "objective_preview": {
          "anyOf": [
            {
              "maxLength": 160,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Objective Preview"
        },
        "prompt_set": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Prompt Set",
          "type": "string"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "tool_call_count": {
          "minimum": 0,
          "title": "Tool Call Count",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "feature_key",
        "status",
        "model_profile",
        "prompt_set",
        "iteration_count",
        "tool_call_count",
        "version",
        "review_required",
        "created_at",
        "updated_at"
      ],
      "title": "AgentRunSummary",
      "type": "object"
    },
    "AgentStepEvidence": {
      "additionalProperties": false,
      "description": "One attributed step in the operations timeline.",
      "properties": {
        "adaptation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdaptationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "model_invocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelInvocationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObservationEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "phase": {
          "$ref": "#/$defs/StepPhase"
        },
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/PlanEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "source": {
          "$ref": "#/$defs/EvidenceSource"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        },
        "summary": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "tool": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolCallEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ToolCallEvidence"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "id",
        "sequence",
        "phase",
        "status",
        "source",
        "summary"
      ],
      "title": "AgentStepEvidence",
      "type": "object"
    },
    "ApprovalStatus": {
      "description": "Human approval state for a protected tool call.",
      "enum": [
        "not_required",
        "pending",
        "approved",
        "rejected"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "EvidenceSource": {
      "description": "Origin of evidence displayed by the operations interface.",
      "enum": [
        "user",
        "orchestration",
        "model",
        "tool",
        "human"
      ],
      "title": "EvidenceSource",
      "type": "string"
    },
    "HumanReviewEvidence": {
      "additionalProperties": false,
      "description": "Immutable, projected human decision for one protected action.",
      "properties": {
        "approval_status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decision": {
          "$ref": "#/$defs/ReviewDecision"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reviewer",
          "type": "string"
        },
        "step_id": {
          "format": "uuid",
          "title": "Step Id",
          "type": "string"
        },
        "tool_name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Tool Name",
          "type": "string"
        },
        "tool_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "step_id",
        "call_id",
        "tool_name",
        "tool_version",
        "approval_status",
        "decision",
        "reviewer",
        "reviewed_at"
      ],
      "title": "HumanReviewEvidence",
      "type": "object"
    },
    "JsonValue": {},
    "ModelInvocationEvidence": {
      "additionalProperties": false,
      "description": "Reproducibility metadata that intentionally excludes prompt content.",
      "properties": {
        "metrics": {
          "$ref": "#/$defs/ModelMetricsEvidence"
        },
        "model": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "model_digest": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Digest"
        },
        "prompt_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Prompt Id",
          "type": "string"
        },
        "prompt_version": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "provider_request_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Request Id"
        },
        "provider_retry_count": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Provider Retry Count",
          "type": "integer"
        },
        "rendered_input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Input Hash",
          "type": "string"
        },
        "repair_count": {
          "maximum": 2,
          "minimum": 0,
          "title": "Repair Count",
          "type": "integer"
        }
      },
      "required": [
        "provider",
        "model",
        "prompt_id",
        "prompt_version",
        "prompt_hash",
        "rendered_input_hash",
        "repair_count",
        "metrics"
      ],
      "title": "ModelInvocationEvidence",
      "type": "object"
    },
    "ModelMetricsEvidence": {
      "additionalProperties": false,
      "description": "Portable model timings and counts safe for developer display.",
      "properties": {
        "cache_write_prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Write Prompt Tokens"
        },
        "cached_prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Prompt Tokens"
        },
        "eval_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eval Duration Ms"
        },
        "load_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Duration Ms"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "prompt_eval_duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Eval Duration Ms"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "retry_count": {
          "default": 0,
          "maximum": 5,
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "total_duration_ms": {
          "minimum": 0,
          "title": "Total Duration Ms",
          "type": "integer"
        }
      },
      "required": [
        "total_duration_ms"
      ],
      "title": "ModelMetricsEvidence",
      "type": "object"
    },
    "ObservationEvidence": {
      "additionalProperties": false,
      "description": "Bounded facts produced from persisted tool evidence.",
      "properties": {
        "facts": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Facts",
          "type": "array"
        },
        "new_constraints": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "New Constraints",
          "type": "array"
        },
        "satisfied_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Satisfied Criteria",
          "type": "array"
        },
        "unassessed_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Unassessed Criteria",
          "type": "array"
        },
        "unsatisfied_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Unsatisfied Criteria",
          "type": "array"
        }
      },
      "title": "ObservationEvidence",
      "type": "object"
    },
    "PlanActionEvidence": {
      "additionalProperties": false,
      "description": "Safe, argument-free summary of one planned tool action.",
      "properties": {
        "purpose": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "sequence": {
          "maximum": 50,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "tool_name": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "tool_name",
        "purpose"
      ],
      "title": "PlanActionEvidence",
      "type": "object"
    },
    "PlanEvidence": {
      "additionalProperties": false,
      "description": "Safe planner output without private reasoning or tool arguments.",
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PlanActionEvidence"
          },
          "maxItems": 50,
          "title": "Actions",
          "type": "array"
        },
        "goal": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        },
        "risk_level": {
          "anyOf": [
            {
              "maxLength": 20,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Risk Level"
        },
        "success_criteria": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Success Criteria",
          "type": "array"
        }
      },
      "required": [
        "goal"
      ],
      "title": "PlanEvidence",
      "type": "object"
    },
    "ReviewDecision": {
      "description": "Human decision for exactly one pending protected action.",
      "enum": [
        "approve",
        "reject"
      ],
      "title": "ReviewDecision",
      "type": "string"
    },
    "RunCorrelation": {
      "additionalProperties": false,
      "description": "Safe identifiers used to correlate a run across service boundaries.",
      "properties": {
        "request_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$",
          "title": "Request Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "telemetry_url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Telemetry Url"
        },
        "trace_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trace Id"
        },
        "traceparent": {
          "anyOf": [
            {
              "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traceparent"
        }
      },
      "required": [
        "request_id",
        "run_id"
      ],
      "title": "RunCorrelation",
      "type": "object"
    },
    "RunLimits": {
      "additionalProperties": false,
      "description": "Hard execution limits controlled by deterministic code.",
      "properties": {
        "max_iterations": {
          "default": 10,
          "maximum": 30,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "max_model_repairs": {
          "default": 1,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Model Repairs",
          "type": "integer"
        },
        "max_parallel_tools": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Max Parallel Tools",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "time_budget_ms": {
          "default": 180000,
          "maximum": 900000,
          "minimum": 1000,
          "title": "Time Budget Ms",
          "type": "integer"
        }
      },
      "title": "RunLimits",
      "type": "object"
    },
    "RunStatus": {
      "description": "Persisted lifecycle of an agent run.",
      "enum": [
        "queued",
        "planning",
        "ready",
        "acting",
        "observing",
        "adapting",
        "review_required",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StepPhase": {
      "description": "Four auditable phases of the shared agentic loop.",
      "enum": [
        "plan",
        "act",
        "observe",
        "adapt"
      ],
      "title": "StepPhase",
      "type": "string"
    },
    "StepStatus": {
      "description": "Execution status of one persisted phase step.",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "StepStatus",
      "type": "string"
    },
    "ToolCallEvidence": {
      "additionalProperties": false,
      "description": "Policy-projected tool request and result evidence.",
      "properties": {
        "approval_status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "call_id": {
          "format": "uuid",
          "title": "Call Id",
          "type": "string"
        },
        "duration_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "evidence_references": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Evidence References",
          "type": "array"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "redacted_arguments": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Arguments"
        },
        "redacted_result": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redacted Result"
        },
        "retryable": {
          "anyOf": [
