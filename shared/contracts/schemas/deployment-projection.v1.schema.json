{
  "$defs": {
    "AiOnboarding": {
      "additionalProperties": false,
      "description": "Feature-owned tool catalogue source, AI-mode mount path and optional guidance corpus.",
      "properties": {
        "rag_corpus": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rag Corpus"
        },
        "rag_corpus_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rag Corpus Id"
        },
        "rag_evidence_kinds": {
          "default": [
            "project_guidance",
            "fixture"
          ],
          "items": {
            "enum": [
              "project_guidance",
              "fixture",
              "official"
            ],
            "type": "string"
          },
          "title": "Rag Evidence Kinds",
          "type": "array"
        },
        "runtime_path": {
          "maxLength": 300,
          "minLength": 2,
          "title": "Runtime Path",
          "type": "string"
        },
        "tool_catalog": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Tool Catalog",
          "type": "string"
        }
      },
      "required": [
        "tool_catalog",
        "runtime_path"
      ],
      "title": "AiOnboarding",
      "type": "object"
    },
    "DatabaseOnboarding": {
      "additionalProperties": false,
      "description": "One database service and the named volumes it exclusively owns.",
      "properties": {
        "database_service": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Database Service",
          "type": "string"
        },
        "volumes": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$",
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Volumes",
          "type": "array"
        }
      },
      "required": [
        "database_service",
        "volumes"
      ],
      "title": "DatabaseOnboarding",
      "type": "object"
    },
    "DeploymentRoute": {
      "additionalProperties": false,
      "description": "One same-origin edge path bound to a declared service.",
      "properties": {
        "kind": {
          "enum": [
            "frontend",
            "backend"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Path",
          "type": "string"
        },
        "service": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path",
        "service"
      ],
      "title": "DeploymentRoute",
      "type": "object"
    },
    "EnabledFeatureProjection": {
      "additionalProperties": false,
      "description": "Deployment-safe projection for one explicitly enabled feature.",
      "properties": {
        "ai": {
          "anyOf": [
            {
              "$ref": "#/$defs/AiOnboarding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "databases": {
          "items": {
            "$ref": "#/$defs/DatabaseOnboarding"
          },
          "title": "Databases",
          "type": "array"
        },
        "enabled": {
          "const": true,
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "evidence_adapter": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceAdapterOnboarding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "feature_key": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Feature Key",
          "type": "string"
        },
        "frontend": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrontendOnboarding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "health_path": {
          "maxLength": 200,
          "minLength": 2,
          "title": "Health Path",
          "type": "string"
        },
        "owner": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Owner",
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/QualityOnboarding"
        },
        "routes": {
          "items": {
            "$ref": "#/$defs/DeploymentRoute"
          },
          "title": "Routes",
          "type": "array"
        }
      },
      "required": [
        "feature_key",
        "owner",
        "routes",
        "quality",
        "databases",
        "health_path"
      ],
      "title": "EnabledFeatureProjection",
      "type": "object"
    },
    "EvidenceAdapterOnboarding": {
      "additionalProperties": false,
      "description": "Optional feature-owned executable that returns its own evidence object.",
      "properties": {
        "path": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "EvidenceAdapterOnboarding",
      "type": "object"
    },
    "FrontendOnboarding": {
      "additionalProperties": false,
      "description": "Feature-owned frontend assets and their edge service projection.",
      "properties": {
        "asset_root": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Asset Root",
          "type": "string"
        },
        "host_port_default": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Host Port Default",
          "type": "integer"
        },
        "host_port_variable": {
          "maxLength": 100,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Host Port Variable",
          "type": "string"
        },
        "internal_port": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Internal Port",
          "type": "integer"
        },
        "route_fragment": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Fragment"
        },
        "service": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "title": "Service",
          "type": "string"
        }
      },
      "required": [
        "asset_root",
        "service",
        "internal_port",
        "host_port_variable",
        "host_port_default"
      ],
      "title": "FrontendOnboarding",
      "type": "object"
    },
    "QualityOnboarding": {
      "additionalProperties": false,
      "description": "Feature-owned test inputs discovered by the repository quality gate.",
      "properties": {
        "coverage_fail_under": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coverage Fail Under"
        },
        "coverage_packages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Coverage Packages",
          "type": "array"
        },
        "node_test_files": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Node Test Files",
          "type": "array"
        },
        "python_test_paths": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Python Test Paths",
          "type": "array"
        }
      },
      "title": "QualityOnboarding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic projection consumed by deployment and quality tooling.",
  "properties": {
    "features": {
      "items": {
        "$ref": "#/$defs/EnabledFeatureProjection"
      },
      "title": "Features",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "features"
  ],
  "title": "DeploymentProjectionV1",
  "type": "object"
}
