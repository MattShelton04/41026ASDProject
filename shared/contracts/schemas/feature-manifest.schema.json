{
  "additionalProperties": false,
  "description": "Domain-neutral metadata owned by one student feature slice.",
  "properties": {
    "ai_capabilities": {
      "default": [],
      "items": {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9_.-]*$",
        "type": "string"
      },
      "maxItems": 50,
      "title": "Ai Capabilities",
      "type": "array"
    },
    "backend_base_path": {
      "maxLength": 200,
      "minLength": 2,
      "title": "Backend Base Path",
      "type": "string"
    },
    "display_name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "feature_key": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_.-]*$",
      "title": "Feature Key",
      "type": "string"
    },
    "frontend_base_path": {
      "maxLength": 200,
      "minLength": 2,
      "title": "Frontend Base Path",
      "type": "string"
    },
    "health_path": {
      "maxLength": 200,
      "minLength": 2,
      "title": "Health Path",
      "type": "string"
    },
    "owner": {
      "enum": [
        "student-1",
        "student-2",
        "student-3",
        "student-4",
        "student-5"
      ],
      "title": "Owner",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "feature_key",
    "display_name",
    "owner",
    "frontend_base_path",
    "backend_base_path",
    "health_path"
  ],
  "title": "FeatureManifest",
  "type": "object"
}
