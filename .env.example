# Default local stack configuration. Copy this file to .env and add the secret locally.
# The Git-ignored .env is loaded automatically by scripts/dev.py stack commands.
AI_MODE_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Production-intended routing: Luna plans; Terra adapts and reviews.
AI_MODE_DEFAULT_MODEL_PROFILE=remote-standard.v1
OPENAI_PROMPT_CACHE_ENABLED=true

# Large Feature 1 releases: bounded CPU projection workers (0 disables parallel projection).
# Keep this within the runner CPU/memory budget; supported range is 0..4.
PROPERTYSCOPE_RELEASE_PROJECTION_WORKERS=2
# Independent jobs may acquire/build concurrently; database imports remain serial.
# Start with 2 on a capable developer machine; accepted range is 1-4, default 1.
PROPERTYSCOPE_ACQUISITION_WORKERS=1
# Declared maximum database budget, not preallocated disk. Physical free-space checks also apply.
# Full PSI history plus retained G-NAF/reference generations needs more than the old 64 GiB budget.
PROPERTYSCOPE_POSTGRES_CAPACITY_BYTES=206158430208
